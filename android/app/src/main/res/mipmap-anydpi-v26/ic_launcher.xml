<?xml version="1.0" encoding="utf-8"?>
<!-- The red pen icon on its own dark background, inset so round and squircle icon shapes never cut the circle. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background>
        <layer-list>
            <item android:drawable="@color/icon_back" />
            <item android:drawable="@mipmap/ic_maskable"
                android:top="8.5dp" android:right="8.5dp" android:left="8.5dp" android:bottom="8.5dp" />
        </layer-list>
    </background>
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
