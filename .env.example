# Copy this file to .env and fill in what you need. Everything has a sensible default.

# ---- Database ----
# SQLite works out of the box on your laptop.
DATABASE_URL=sqlite:///./asol_dam.db
# For hosting, paste your Neon/Supabase connection string instead, e.g.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Minimum hours between two price checks of the same product (be polite to the store).
MIN_REFRESH_HOURS=6

# Load sample products on first start so the site isn't empty. Set to 0 once you have real ones.
SEED_DEMO_DATA=1

# ---- Automatic price checks (Phase 2) ----
SCHEDULER_ENABLED=1
CHECK_TIMES=10:00,22:00
TIMEZONE=Asia/Dhaka

# ---- Telegram alerts (Phase 2) ----
# Get these from @BotFather in Telegram (see README). Leave empty to turn alerts off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# "polling" on your laptop. "webhook" on a hosted site (see DEPLOY.md).
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=

# Read each size's sale price by opening Daraz pages in a hidden Edge/Chrome (1 = on, 0 = off).
BROWSER_PRICES=1
# Which browser: msedge, chrome, or leave empty to try Edge, then Chrome, then Playwright's Chromium.
BROWSER_CHANNEL=
